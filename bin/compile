#!/usr/bin/env bash

set -e

BUILD_DIR=$1
CACHE_DIR=$2

# config
VERSION="5.0.2"
MINOR_VERSION="5.0"

# LibreOffice Binaries URL - use official archive since S3 objects no longer exist
# Official archive URL: https://downloadarchive.documentfoundation.org/libreoffice/old/5.0.2.1/deb/x86_64/
DEB_DOWNLOAD_URL="https://downloadarchive.documentfoundation.org/libreoffice/old/5.0.2.1/deb/x86_64/LibreOffice_5.0.2.1_Linux_x86-64_deb.tar.gz"
FILE_NAME=libreoffice${VERSION}_x86-64.tar.gz
ARCHIVE_NAME=opt/libreoffice${VERSION}

# LibreOffice Dependencies URL - still try S3 first, fallback to building if needed
DEPS_FILE_NAME=libreoffice${VERSION}_x86-64_deps.tar.gz
DEPS_BUILDPACK_LIBREOFFICE_PACKAGE=https://s3-eu-west-1.amazonaws.com/libreoffice-heroku-buildpack/${DEPS_FILE_NAME}
DEPS_ARCHIVE_NAME=app/vendor/libreoffice/deps

# Font URL
FONT_OCRA_FILE_NAME=OCRA.ttf
FONT_OCRA_BUILDPACK_LIBREOFFICE_PACKAGE=https://github.com/opensourcedesign/fonts/blob/master/OCRA/${FONT_OCRA_FILE_NAME}?raw=true
FONT_OCRA_ARCHIVE_NAME=libreoffice/share/fonts/truetype

mkdir -p $CACHE_DIR
if ! [ -e $CACHE_DIR/$FILE_NAME ]; then
  echo "-----> LibreOffice: Downloading LibreOffice ${VERSION} binaries from official archive"
  echo "-----> Source: ${DEB_DOWNLOAD_URL}"
  
  # Download the .deb tar.gz from official archive
  DEB_TAR_FILE=$CACHE_DIR/LibreOffice_${VERSION}_Linux_x86-64_deb.tar.gz
  curl -L $DEB_DOWNLOAD_URL -o $DEB_TAR_FILE
  
  # Extract the .deb tar.gz
  DEB_EXTRACT_DIR=$(mktemp -d)
  tar xzf $DEB_TAR_FILE -C $DEB_EXTRACT_DIR
  DEB_ARCHIVE_NAME=$(ls $DEB_EXTRACT_DIR | head -1)
  
  # Extract all .deb files
  cd $DEB_EXTRACT_DIR/$DEB_ARCHIVE_NAME
  for f in DEBS/*.deb; do
    ar p "$f" data.tar.gz | tar zx
  done
  
  # Create the final tar.gz with opt/libreoffice structure
  cd $DEB_EXTRACT_DIR
  tar pczf $CACHE_DIR/$FILE_NAME opt
  
  # Cleanup
  rm -rf $DEB_EXTRACT_DIR
  rm -f $DEB_TAR_FILE
  
  echo "-----> LibreOffice: Successfully extracted and cached LibreOffice binaries"
fi

if ! [ -e $CACHE_DIR/$DEPS_FILE_NAME ]; then
  echo "-----> LibreOffice: Downloading LibreOffice dependencies (gettext, dbus, libffi, glib, dbus-glib)"
  # Try S3 first, but it may not exist
  if curl -f -L $DEPS_BUILDPACK_LIBREOFFICE_PACKAGE -o $CACHE_DIR/$DEPS_FILE_NAME 2>/dev/null; then
    echo "-----> Successfully downloaded dependencies from S3"
  else
    echo "-----> Warning: S3 dependencies not available. Dependencies may need to be built."
    echo "-----> Note: This buildpack expects pre-built dependencies. If build fails, dependencies need to be rebuilt."
    # Create empty deps directory structure as fallback
    mkdir -p $BUILD_DIR/vendor/libreoffice/deps/lib
    touch $CACHE_DIR/$DEPS_FILE_NAME  # Mark as "downloaded" to skip retry
  fi
fi

if ! [ -e $CACHE_DIR/$FONT_OCRA_FILE_NAME ]; then
  echo "-----> Fonts: Get OCRA-Font from ${FONT_OCRA_BUILDPACK_LIBREOFFICE_PACKAGE}"
  curl -L $FONT_OCRA_BUILDPACK_LIBREOFFICE_PACKAGE -o $CACHE_DIR/$FONT_OCRA_FILE_NAME
fi

echo "-----> LibreOffice: Extracting LibreOffice ${VERSION} binaries to ${BUILD_DIR}/vendor/libreoffice"
mkdir -p $CACHE_DIR/$ARCHIVE_NAME
mkdir -p $BUILD_DIR/vendor/
tar xzf $CACHE_DIR/$FILE_NAME -C $CACHE_DIR/$ARCHIVE_NAME
mv ${CACHE_DIR}/${ARCHIVE_NAME}/opt/libreoffice${MINOR_VERSION} $BUILD_DIR/vendor/libreoffice

echo "-----> LibreOffice: Extracting LibreOffice dependencies to ${BUILD_DIR}/vendor/libreoffice/deps"
mkdir -p $CACHE_DIR/$DEPS_ARCHIVE_NAME
# Only extract if the deps file exists and is not empty
if [ -s $CACHE_DIR/$DEPS_FILE_NAME ]; then
  tar xzf $CACHE_DIR/$DEPS_FILE_NAME -C $CACHE_DIR
  mv $CACHE_DIR/$DEPS_ARCHIVE_NAME $BUILD_DIR/vendor/libreoffice/deps
else
  echo "-----> Warning: Dependencies file is missing or empty. Creating minimal deps structure."
  mkdir -p $BUILD_DIR/vendor/libreoffice/deps/lib
  # Note: libGL.so.8.0.0 should come from the dependencies, but if deps are missing,
  # the build will likely fail when trying to run soffice
fi

echo "-----> LibreOffice: Setting PATH and LD_LIBRARY_PATH"
PROFILE_PATH="$BUILD_DIR/.profile.d/libreoffice.sh"
mkdir -p $(dirname $PROFILE_PATH)

echo "-----> Fonts: Installing fonts in ${FONT_OCRA_ARCHIVE_NAME}"
mv $CACHE_DIR/$FONT_OCRA_FILE_NAME ${BUILD_DIR}/vendor/${FONT_OCRA_ARCHIVE_NAME}

# adding lib symlink - ensure libGL.so.1 exists for soffice to run
cd $BUILD_DIR/vendor/libreoffice/deps/lib/
# Check if libGL.so.8.0.0 exists before creating symlink
if [ -f "libGL.so.8.0.0" ]; then
  ln -sf libGL.so.8.0.0 libGL.so.1
  echo "Created libGL.so.1 symlink"
else
  echo "Warning: libGL.so.8.0.0 not found, libGL.so.1 symlink not created"
fi

# remove vendor docs
echo "-----> LibreOffice: Remove something"
echo `ls $BUILD_DIR/vendor/libreoffice/deps`
rm -rf $BUILD_DIR/vendor/libreoffice/deps/shared/gtk-doc
rm -rf $BUILD_DIR/vendor/libreoffice/deps/shared/man
rm -rf $BUILD_DIR/vendor/libreoffice/program/wizards
#rm -rf $BUILD_DIR/vendor/libreoffice/deps/lib/libGL.so.8.0.0
rm -rf $BUILD_DIR/vendor/libreoffice/deps/share/locale
rm -rf $BUILD_DIR/vendor/libreoffice/deps/include
rm -rf $BUILD_DIR/vendor/libreoffice/deps/bin/dbus-daemon
rm -rf $BUILD_DIR/vendor/libreoffice/deps/bin/xgettext
rm -rf $BUILD_DIR/vendor/libreoffice/share/extensions/nlpsolver
rm -rf $BUILD_DIR/vendor/libreoffice/share/extensions/wiki-publisher
rm -rf $BUILD_DIR/vendor/libreoffice/deps/share/doc/gettext
rm -rf $BUILD_DIR/app/vendor/libreoffice/deps/share/gtk-doc
rm -rf $BUILD_DIR/vendor/libreoffice/deps/share/bash-completition
#rm -rf $BUILD_DIR/vendor/libreoffice/deps/lib/libGLU.so.1.3.1
rm -rf $BUILD_DIR/vendor/libreoffice/deps/lib/libGLU.a
rm -rf $BUILD_DIR/vendor/libreoffice/deps/lib/libGLU.a
echo "-----> LibreOffice: finish remove"

# add vendor binaries to the path
echo 'export PATH="$HOME/vendor/libreoffice/program:/app/vendor/libreoffice/deps/bin:$PATH"' >> $PROFILE_PATH

# configure LD_LIBRARY_PATH to include dependencies
echo 'export LD_LIBRARY_PATH="$HOME/vendor/libreoffice/deps/lib:$LD_LIBRARY_PATH"' >> $PROFILE_PATH

echo "==================================== GENERATE LIBREOFFICE CONFIG ===================================="

# Set LD_LIBRARY_PATH before running soffice to ensure libGL.so.1 can be found
# This is critical - soffice needs to find libGL.so.1 in the deps/lib directory
export LD_LIBRARY_PATH="$BUILD_DIR/vendor/libreoffice/deps/lib:$LD_LIBRARY_PATH"

# Verify libGL.so.1 is accessible
if [ ! -f "$BUILD_DIR/vendor/libreoffice/deps/lib/libGL.so.1" ] && [ ! -L "$BUILD_DIR/vendor/libreoffice/deps/lib/libGL.so.1" ]; then
  echo "Error: libGL.so.1 not found in deps/lib. Cannot generate LibreOffice config."
  exit 1
fi

# Run soffice with a fake macro so the .config directory is generated
# This is CRITICAL for runtime - the config must be generated during build
echo "Running soffice to generate LibreOffice config..."
$BUILD_DIR/vendor/libreoffice/program/soffice --headless --invisible 'macro:///' || {
  echo "Error: soffice config generation failed. This is required for runtime."
  echo "LD_LIBRARY_PATH was: $LD_LIBRARY_PATH"
  echo "Checking for libGL.so.1:"
  ls -la "$BUILD_DIR/vendor/libreoffice/deps/lib/libGL.so"* || echo "No libGL.so files found"
  exit 1
}

# Move generated .config to the build dir so it's persisted after slug compilation
LIBREOFFICE_CONFIG_DIR=$BUILD_DIR/.config/libreoffice
LIBREOFFICE_SOURCE_CONFIG_DIR=/app/.config/libreoffice/4
mkdir -p $LIBREOFFICE_CONFIG_DIR
if [ -d "$LIBREOFFICE_SOURCE_CONFIG_DIR" ]; then
  cp -rf $LIBREOFFICE_SOURCE_CONFIG_DIR $LIBREOFFICE_CONFIG_DIR || true
fi
echo "Copying macro..."
# Copy custom macro (if macros directory exists)
MACRO_PATH=$BUILD_DIR/misc/libreoffice_macros/*
if [ -d "$BUILD_DIR/misc/libreoffice_macros" ]; then
  LIBREOFFICE_MACROS_DIRECTORY=$LIBREOFFICE_CONFIG_DIR/4/user/basic/Standard/
  mkdir -p $LIBREOFFICE_MACROS_DIRECTORY
  cp ${MACRO_PATH} ${LIBREOFFICE_MACROS_DIRECTORY} 2>/dev/null || true
fi

echo "=================================== DONE ================================"
